# Скопируйте в .env и заполните. .env в git не попадает.
# Секреты генерируются отдельно для dev и prod, хранятся в менеджере паролей.

# --- Django ---
# Случайная строка не короче 50 символов:
#   uv run --project backend python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
# Секретный путь админки без ведущего слэша и со слэшем в конце, например: <случайная-строка>/
ADMIN_URL=

# --- PostgreSQL: суперпользователь (только инициализация и обслуживание) ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- PostgreSQL: пользователь приложения (не суперпользователь, права только на свою базу) ---
APP_DB_NAME=
APP_DB_USER=
APP_DB_PASSWORD=

# --- Caddy ---
# Локально: localhost; в проде: xn--80abvidn.xn--p1ai
CADDY_SITE_ADDRESS=
